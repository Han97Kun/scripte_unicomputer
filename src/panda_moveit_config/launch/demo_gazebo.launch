<?xml version="1.0"?>
<launch>
  <!-- MoveIt options -->
  <arg name="pipeline" default="ompl" doc="Planning pipeline to use with MoveIt"/>

  <!-- Panda options : gripper set to false-->
  <arg name="load_gripper" default="false" />
  <arg name="transmission" default="effort" />

  <!-- Gazebo options -->
  <arg name="gazebo_gui" default="true" doc="Start Gazebo GUI"/>
  <arg name="paused" default="false" doc="Start Gazebo paused"/>

  <!-- Launch the gazebo simulator and spawn the robot -->
  <include file="$(find franka_gazebo)/launch/panda.launch" pass_all_args="true">
    <arg name="headless" value="$(eval not arg('gazebo_gui'))" />
    <arg name="use_gripper" default="$(arg load_gripper)" />
    <arg name="controller" default="$(arg transmission)_joint_trajectory_controller" />
  </include>

  <!-- Launch MoveIt -->
  <include file="$(dirname)/demo.launch" pass_all_args="true">
    <!-- robot_description is loaded by gazebo.launch, to enable Gazebo features -->
    <arg name="load_robot_description" value="false" />
    <!-- MoveItSimpleControllerManager provides ros_control's JointTrajectory controllers
         as well as GripperCommand actions -->
    <arg name="moveit_controller_manager" value="simple" />
  </include>

    <!-- spawn models in gazebo -->

  <node name="spawn_wall" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-file $(find franka_gazebo)/models/mtec_wall/model.sdf -sdf -model wall -x 0 -y 0 -z 0" />

  <node name="spawn_leg1" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-file $(find franka_gazebo)/models/mtec_leg1/model.sdf -sdf -model leg1 -x 0 -y 0 -z 0" />

  <node name="spawn_leg2" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-file $(find franka_gazebo)/models/mtec_leg2/model.sdf -sdf -model leg2 -x 0 -y 0 -z 0" />

  <node name="spawn_leg3" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-file $(find franka_gazebo)/models/mtec_leg3/model.sdf -sdf -model leg3 -x 0 -y 0 -z 0" />

  <node name="spawn_leg4" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-file $(find franka_gazebo)/models/mtec_leg4/model.sdf -sdf -model leg4 -x 0 -y 0 -z 0" />

  <node name="spawn_table" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-file $(find franka_gazebo)/models/mtec_table/model.sdf -sdf -model table -x 0 -y 0 -z 0" />

  <node name="spawn_source" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-file $(find franka_gazebo)/models/mtec_source/model.sdf -sdf -model source -x 0 -y 0 -z 0" />

</launch>
