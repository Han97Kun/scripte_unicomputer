<?xml version="1.0" encoding="utf-8"?>
<robot name="panda_with_sensor" xmlns:xacro="http://www.ros.org/wiki/xacro">

 <!-- Panda-Arm Xacro einbinden -->
 <xacro:include filename="$(find franka_description)/robots/panda_arm.urdf.xacro"/>

 <!-- joint_limits.yaml LADEN
      PRÜFE, welcher Pfad bei dir existiert und LASS GENAU EINE ZEILE stehen:
      Variante A (häufig bei Panda):
 -->
 <xacro:property name="joint_limits_yaml"
                 value="${xacro.load_yaml('$(find franka_description)/robots/panda/joint_limits.yaml')}"/>
 <!-- Variante B (falls oben nicht existiert):
 <xacro:property name="joint_limits_yaml"
                 value="${xacro.load_yaml('$(find franka_description)/robots/fr3/joint_limits.yaml')}"/>
 -->

 <!-- Panda MIT _sc-Links erzeugen (Makro heißt bei dir 'franka_arm') -->
 <xacro:franka_arm arm_id:="panda"
                   description_pkg:="franka_description"
                   connected_to:=""
                   xyz:="0 0 0"
                   rpy:="0 0 0"
                   gazebo:=false
                   safety_distance:=0
                   joint_limits="${joint_limits_yaml}"/>

 <!-- Sonden-Parameter -->
 <xacro:property name="sensor_scale" value="0.001 0.001 0.001"/>
 <xacro:property name="sensor_xyz"   value="0 0 0"/>
 <xacro:property name="sensor_rpy"   value="0 0 0"/>

 <!-- Sonden-Link -->
 <link name="sensor_mount">
   <visual>
     <geometry>
       <mesh filename="package://panda_sonde_wrapper_description/meshes/visual/halterung_panda_gamma_sonde.stl"
             scale="${sensor_scale}"/>
     </geometry>
   </visual>
   <collision>
     <geometry>
       <!-- habe keine collisionsdatei, nehme die selbe -->
       <mesh filename="package://panda_sonde_wrapper_description/meshes/collision/halterung_panda_gamma_sonde.stl"
             scale="${sensor_scale}"/>
     </geometry>
   </collision>
   <inertial>
     <origin xyz="0 0 0" rpy="0 0 0"/>
     <mass value="0.10"/>
     <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
   </inertial>
 </link>

 <!-- Fest am Flansch -->
 <joint name="sensor_mount_joint" type="fixed">
   <parent link="panda_link8"/>
   <child  link="sensor_mount"/>
   <origin xyz="${sensor_xyz}" rpy="${sensor_rpy}"/>
 </joint>

 <!-- Kollision Sonde vs. Flansch erlauben (weil montiert) -->
 <disable_collisions link1="panda_link8_sc" link2="sensor_mount" reason="Adjacent"/>
 <disable_collisions link1="panda_link8"    link2="sensor_mount" reason="Adjacent"/>

</robot>